# Layered on top of sdkconfig.defaults for dev builds (esp-idf-sys picks up
# `sdkconfig.defaults.<profile>` on its own) - see the file for the layout.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.debug.csv"

# Lets `LOG_LEVEL` (see `apply_log_levels` in main.rs) go above `info` -
# `LOG_MAXIMUM_LEVEL` is the compile-time ceiling (sdkconfig.defaults pins it
# to `info` to keep release builds small). The runtime default stays `info`.
CONFIG_LOG_MAXIMUM_LEVEL_INFO=n
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
