{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "rust: cargo build"
		},
		{
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release"
			],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "rust: cargo build --release"
		},
		{
			"type": "shell",
			"command": "cargo",
			"args": [
				"bloat",
				"--symbols-section", ".flash.text"
			],
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "rust: cargo bloat"
		},
		{
			"type": "shell",
			"command": "scripts/sign.sh",
			"problemMatcher": [],
			"group": "build",
			"dependsOn": [
				"rust: cargo build --release"
			],
			"label": "rust: build esp32c3 release"
		}
	]
}